# =============================================
# WhatsApp Conversation Analyzer — Configuración
# Copia este archivo a .env y completa los valores
# =============================================

# ── WhatsApp ──────────────────────────────────
# Nombre EXACTO del grupo de WhatsApp a escuchar
# (Debe coincidir letra por letra con el nombre del grupo)
WHATSAPP_GROUP_NAME=Mi Grupo de Proyecto

# ── Telegram ──────────────────────────────────
# Token del bot (créalo con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIjKlMnOpQrStUvWxYz

# Tu Chat ID personal como PM (obtenlo hablando con @userinfobot en Telegram)
TELEGRAM_CHAT_ID=123456789

# ── DeepSeek AI ───────────────────────────────
# API Key de platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Modelos disponibles:
#   deepseek-chat      → rápido, 128K contexto (recomendado)
#   deepseek-reasoner  → razonamiento profundo (chain-of-thought), más lento
DEEPSEEK_MODEL=deepseek-chat

# ── Scheduler ─────────────────────────────────
# Cada cuántos minutos se ejecuta el análisis automático (default: 30)
ANALYSIS_INTERVAL_MINUTES=30
