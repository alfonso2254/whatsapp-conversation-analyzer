# =============================================
# WhatsApp Conversation Analyzer — Configuración
# Copia este archivo a .env y completa los valores
# =============================================

# ── WhatsApp ──────────────────────────────────
# Nombre EXACTO del grupo de WhatsApp a escuchar
# (Debe coincidir letra por letra con el nombre del grupo)
WHATSAPP_GROUP_NAME=Mi Grupo de Proyecto

# ── Telegram ──────────────────────────────────
# Token del bot (créalo con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIjKlMnOpQrStUvWxYz

# Tu Chat ID personal como PM (obtenlo hablando con @userinfobot en Telegram)
TELEGRAM_CHAT_ID=123456789

# ── Kimi API (MoonShot AI) ────────────────────
# API Key de platform.moonshot.ai
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Modelos disponibles:
#   kimi-k2-turbo-preview   → rápido, 256K contexto (recomendado)
#   kimi-k2-thinking        → razonamiento profundo, más lento
KIMI_MODEL=kimi-k2-turbo-preview

# ── Scheduler ─────────────────────────────────
# Cada cuántos minutos se ejecuta el análisis automático (default: 30)
ANALYSIS_INTERVAL_MINUTES=30
